---
export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const { title, description = 'Milad Zarei-Maleki | Systems Software & Kernel Observability Researcher', image, type = 'website' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const siteURL = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://milad.zareimaleki.ir';
const metaImage = image ? new URL(image, Astro.url).toString() : `${siteURL}/avatar.jpg`;

const pageTitle = title ? `${title} :: Milad Zarei-Maleki` : 'Milad Zarei-Maleki | Systems Software Researcher';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteURL}/#website`,
  'url': siteURL,
  'name': 'Milad Zarei-Maleki',
  'alternateName': ['Milad Zarei', 'miladzm', 'milad.zareimaleki.ir', 'miladzm.ir'],
  'description': 'Personal portfolio & systems research showcase for Milad Zarei-Maleki',
  'inLanguage': 'en-US',
};

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteURL}/#person`,
  'name': 'Milad Zarei-Maleki',
  'url': siteURL,
  'image': `${siteURL}/avatar.jpg`,
  'jobTitle': 'Systems Software & Kernel Observability Researcher',
  'description': 'Computer Engineering student at IUST, researcher at Deep Observability Lab specializing in dynamic kernel tracing, DPDK, and operating systems.',
  'worksFor': {
    '@type': 'ResearchOrganization',
    'name': 'Deep Observability Lab, IUST',
  },
  'alumniOf': {
    '@type': 'EducationalOrganization',
    'name': 'Iran University of Science and Technology',
    'url': 'http://www.iust.ac.ir/',
  },
  'sameAs': [
    'https://github.com/MiliAxe',
    'https://linkedin.com/in/milad-zarei-maleki',
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="alternate icon" type="image/x-icon" href={`${base}favicon.ico`} />
    <meta name="generator" content={Astro.generator} />
    
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Milad Zarei-Maleki" />
    <meta name="robots" content="index, follow" />
    <meta name="keywords" content="Milad Zarei-Maleki, Systems Software, Kernel Observability, Dynamic Tracing, uftrace, DPDK, eBPF, xv6, QEMU, IUST" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Social Media -->
    <meta property="og:site_name" content="Milad Zarei-Maleki" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={metaImage} />
    
    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@MiliAxe" />
    <meta name="twitter:creator" content="@MiliAxe" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={metaImage} />
    
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <link rel="alternate" type="application/rss+xml" title="RSS" href={`${base}rss.xml`} />

    <!-- Google Structured Data (JSON-LD) for Site Name and Identity -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify([websiteSchema, personSchema])} />
  </head>
  <body>
    <div class="container center">
      <header class="header">
        <div class="header__inner">
          <div class="header__logo">
            <a href={base}>
              <div class="logo">
                milad@sys:~$
              </div>
            </a>
          </div>
          <ul class="menu menu--mobile">
            <li class="menu__trigger">Menu ▾</li>
            <li>
              <ul class="menu__dropdown">
                <li><a href={`${base}about/`}>About</a></li>
                <li><a href={`${base}research/`}>Research</a></li>
                <li><a href={`${base}projects/`}>Projects</a></li>
                <li><a href={`${base}teaching/`}>Teaching</a></li>
                <li><a href={`${base}posts/`}>Posts</a></li>
                <li><a href={`${base}CV_Milad_Zarei_Maleki.pdf`} target="_blank" rel="noopener">CV (PDF) ↗</a></li>
              </ul>
            </li>
          </ul>
        </div>
        
        <nav class="navigation-menu">
          <ul class="navigation-menu__inner menu--desktop">
            <li><a href={`${base}about/`}>About</a></li>
            <li><a href={`${base}research/`}>Research</a></li>
            <li><a href={`${base}projects/`}>Projects</a></li>
            <li><a href={`${base}teaching/`}>Teaching</a></li>
            <li><a href={`${base}posts/`}>Posts</a></li>
            <li><a href={`${base}CV_Milad_Zarei_Maleki.pdf`} target="_blank" rel="noopener" class="cv-link">CV ↗</a></li>
          </ul>
        </nav>
      </header>
      
      <main class="content">
        <slot />
      </main>
      
      <footer class="footer">
        <div class="footer__inner">
          <div class="copyright">
            <span>© 2026 Milad Zarei-Maleki</span>
            <span class="separator">::</span>
            <span><a href="https://github.com/MiliAxe" target="_blank" rel="noopener">GitHub</a></span>
            <span class="separator">::</span>
            <span><a href="https://linkedin.com/in/milad-zarei-maleki" target="_blank" rel="noopener">LinkedIn</a></span>
            <span class="separator">::</span>
            <span><a href="mailto:milad_zarei@comp.iust.ac.ir">Email</a></span>
            <span class="separator">::</span>
            <span>Tehran, Iran</span>
          </div>
        </div>
      </footer>
    </div>
    
    <script>
      // Menu functionality
      (() => {
        const container = document.querySelector(".container");
        const menus = document.querySelectorAll(".menu");
        
        // Close menus when clicking outside
        document.body.addEventListener("click", () => {
          menus.forEach(menu => {
            if (menu.classList.contains("open")) {
              menu.classList.remove("open");
            }
          });
        });
        
        // Close menus on window resize
        window.addEventListener("resize", () => {
          menus.forEach(menu => {
            menu.classList.remove("open");
          });
        });
        
        // Menu trigger functionality
        menus.forEach(menu => {
          const trigger = menu.querySelector(".menu__trigger");
          const dropdown = menu.querySelector<HTMLElement>(".menu__dropdown");
          
          if (trigger && dropdown) {
            trigger.addEventListener("click", event => {
              event.stopPropagation();
              
              if (menu.classList.contains("open")) {
                menu.classList.remove("open");
              } else {
                // Close other menus
                menus.forEach(m => m.classList.remove("open"));
                menu.classList.add("open");
              }
              
              // Adjust dropdown position if it goes outside container
              if (container && dropdown.getBoundingClientRect().right > container.getBoundingClientRect().right) {
                dropdown.style.left = "auto";
                dropdown.style.right = "0";
              }
            });
            
            dropdown.addEventListener("click", e => e.stopPropagation());
          }
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  /* Import all CSS files in the correct order */
  @import "../styles/terminal.css";
  @import "../styles/fonts.css";
  @import "../styles/main.css";
  @import "../styles/header.css";
  @import "../styles/menu.css";
  @import "../styles/footer.css";
  @import "../styles/buttons.css";
  @import "../styles/post.css";
  @import "../styles/pagination.css";
  @import "../styles/code.css";
  @import "../styles/syntax.css";
  @import "../styles/gist.css";
  @import "../styles/terms.css";
</style>