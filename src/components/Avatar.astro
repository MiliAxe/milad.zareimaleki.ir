---
interface Props {
  defaultMode?: 'ascii' | 'photo';
  showToggle?: boolean;
}

const { defaultMode = 'ascii', showToggle = true } = Astro.props;

// High-fidelity ASCII art generated directly from avatar.jpg
const asciiArt = `                                              
                                              
                         @                    
                 @%#########%@                
                ###############%              
              @###%@@@@%#########             
              ###@+====++*@@@@@##%            
             @##@++===+******++@@#            
             @#%@++++==+++***+**%#            
             %#@+*%%##%***+++*@@@#            
           *%@#%@%%%####%@@@#####%            
           %%@@*%#@%#@%@%%%#######            
           %%#%*+%+++*++%*%#@##%##%           
            %@%***%*++*%*+@##@@@%%            
             *%%**+*****+++%%%%#%             
              *%+**++++%%*%#@@@#@             
              %%+**+++++@%#%@@#%              
            **%#@++++**%*@%%%%#               
           %+*#%#%++***%###@@#                
         %*==*#@*%%*++++@@@%#@                
     *****===*#++*%#%@@@@@%#%                 
  **+++=++===+%@+++%########%#                
+++=====++====*%+++*%%%####@@%%%%*            
========*=====+%%++**@@@@##+****@*%%%*        
=======++======+#*+***@@%#*+**@%***@**%**     
=======++=======*@*+@@@@@@=+@@*@@*@@***@@@    `;
---

<div class="avatar-widget framed" data-current-mode={defaultMode}>
  {showToggle && (
    <div class="avatar-header">
      <div class="avatar-cmd">
        <span class="avatar-prompt">$</span> <span class="avatar-cmd-text">cat avatar.ascii</span>
      </div>
      <div class="avatar-controls">
        <button type="button" class="mode-btn btn-ascii active" data-mode="ascii" aria-label="Show ASCII portrait">ASCII</button>
        <button type="button" class="mode-btn btn-photo" data-mode="photo" aria-label="Show JPEG portrait">JPEG</button>
      </div>
    </div>
  )}

  <div class="avatar-body">
    <!-- ASCII Art Mode (Default) -->
    <div class="avatar-view avatar-ascii-view">
      <pre class="ascii-canvas">{asciiArt}</pre>
      <div class="canvas-caption">
        <span>render: ASCII 46x26</span>
        <span class="sep">::</span>
        <span>charset: @%#*+=-:.</span>
      </div>
    </div>

    <!-- Photo Mode -->
    <div class="avatar-view avatar-photo-view" style="display: none;">
      <img src="/avatar.jpg" alt="Milad Zarei-Maleki" class="avatar-img" />
      <div class="canvas-caption">
        <span>avatar.jpg [1024x1024]</span>
        <span class="sep">::</span>
        <span>pixel art portrait</span>
      </div>
    </div>
  </div>
</div>

<script>
  function setupAvatarWidgets() {
    const widgets = document.querySelectorAll<HTMLElement>('.avatar-widget');

    widgets.forEach((widget) => {
      const asciiView = widget.querySelector<HTMLElement>('.avatar-ascii-view');
      const photoView = widget.querySelector<HTMLElement>('.avatar-photo-view');
      const btnAscii = widget.querySelector<HTMLButtonElement>('.btn-ascii');
      const btnPhoto = widget.querySelector<HTMLButtonElement>('.btn-photo');
      const cmdText = widget.querySelector<HTMLElement>('.avatar-cmd-text');

      function setMode(mode: 'ascii' | 'photo') {
        if (mode === 'ascii') {
          if (asciiView) asciiView.style.display = 'block';
          if (photoView) photoView.style.display = 'none';
          btnAscii?.classList.add('active');
          btnPhoto?.classList.remove('active');
          if (cmdText) cmdText.textContent = 'cat avatar.ascii';
          widget.setAttribute('data-current-mode', 'ascii');
        } else {
          if (asciiView) asciiView.style.display = 'none';
          if (photoView) photoView.style.display = 'block';
          btnPhoto?.classList.add('active');
          btnAscii?.classList.remove('active');
          if (cmdText) cmdText.textContent = 'display avatar.jpg';
          widget.setAttribute('data-current-mode', 'photo');
        }
      }

      btnAscii?.addEventListener('click', () => setMode('ascii'));
      btnPhoto?.addEventListener('click', () => setMode('photo'));
    });
  }

  // Initialize on load & Astro transitions
  setupAvatarWidgets();
  document.addEventListener('astro:page-load', setupAvatarWidgets);
</script>

<style>
  .avatar-widget {
    background: color-mix(in srgb, var(--background) 95%, white 5%);
    max-width: 380px;
    margin: 0 auto 30px auto;
    padding: 12px;
  }

  .avatar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom: 1px dashed color-mix(in srgb, var(--accent) 30%, transparent);
    font-size: 0.85rem;
  }

  .avatar-cmd {
    font-family: inherit;
    color: var(--foreground);
    opacity: 0.9;
  }

  .avatar-prompt {
    color: var(--accent);
    font-weight: bold;
    margin-right: 4px;
  }

  .avatar-controls {
    display: flex;
    gap: 4px;
  }

  .mode-btn {
    font-size: 0.75rem;
    padding: 2px 8px;
    border: 1px solid var(--accent);
    background: transparent;
    color: var(--accent);
    cursor: pointer;
    font-family: inherit;
    font-weight: 600;
    transition: all 0.15s ease;
  }

  .mode-btn:hover {
    background: color-mix(in srgb, var(--accent) 15%, transparent);
  }

  .mode-btn.active {
    background: var(--accent);
    color: var(--background);
  }

  .avatar-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .avatar-view {
    width: 100%;
    text-align: center;
  }

  .ascii-canvas {
    font-family: "Fira Code", "JetBrains Mono", Monaco, Consolas, monospace !important;
    font-size: clamp(0.44rem, 1.15vw, 0.65rem);
    line-height: 1.1;
    letter-spacing: 0;
    color: var(--accent);
    background: var(--background);
    padding: 14px 8px;
    margin: 0 auto;
    display: block;
    width: fit-content;
    text-align: center;
    white-space: pre;
    overflow-x: hidden;
    user-select: none;
    text-shadow: 0 0 4px color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .avatar-img {
    display: block;
    max-width: 100%;
    max-height: 320px;
    margin: 0 auto;
    border: 3px solid var(--accent);
    border-radius: var(--radius);
    padding: 4px;
    image-rendering: pixelated;
  }

  .canvas-caption {
    margin-top: 8px;
    font-size: 0.78rem;
    color: var(--foreground);
    opacity: 0.75;
    display: flex;
    justify-content: center;
    gap: 8px;
  }

  .sep {
    color: var(--accent);
  }
</style>
